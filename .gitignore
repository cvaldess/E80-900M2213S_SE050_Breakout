# KiCad backups, autosaves and lock files
*.bak
*.bak_*
*.kicad_pcb-bak
*.kicad_sch-bak
_autosave-*
*-backups/
~*.lck

# Local editor / cache state (machine-specific, not part of the design)
*.kicad_prl
fp-info-cache
.history/

# Check reports, regenerated on demand
*-drc.rpt
*-erc.rpt

# Third-party documentation: get the current version from the manufacturer
*_UserManual_*.pdf
